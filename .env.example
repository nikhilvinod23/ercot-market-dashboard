# Required: primary subscription key from the ERCOT API Explorer profile.
ERCOT_SUBSCRIPTION_KEY=

# Recommended for automatic one-hour ID-token renewal.
ERCOT_USERNAME=
ERCOT_PASSWORD=

# Optional short-term alternative: paste a current ID token here.
# ERCOT_ID_TOKEN=

PORT=8000

# Local Python archive collector starts on launch and runs hourly.
# ARCHIVE_COLLECTOR=off
# PYTHON_EXECUTABLE=python

# Optional database mirror; SQLite and the public JSONL archive work without it.
# DATABASE_URL=
