# Required for authenticated hub prices and issued forecast archives.
ERCOT_SUBSCRIPTION_KEY=

# Recommended for automatic one-hour ID-token renewal.
ERCOT_USERNAME=
ERCOT_PASSWORD=

# Optional short-term alternative: paste a current ID token here.
# ERCOT_ID_TOKEN=

# Optional: mirror the same normalized records to PostgreSQL you control.
# DATABASE_URL=postgresql://user:password@localhost:5432/ercot

# Local dashboard preview omits this. GitHub Pages build uses the repository path.
# NEXT_PUBLIC_BASE_PATH=/ercot-market-dashboard
